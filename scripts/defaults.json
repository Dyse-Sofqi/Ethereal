{
  "_comment": "Ethereal 主题默认值（官方变量层）。key = 官方变量名（不含 -- 前缀，与 @settings id 一致）；string = 明暗同值默认；{light,dark} = 明/暗分别默认，缺省一侧表示该模式保持官方值。gen-settings.mjs 据此生成 theme.css 的 @settings 默认值与「主题默认值（官方变量层）」CSS 区域。",
  "indent-size": "2",
  "indent-unit": "0.25em",
  "ribbon-background": "var(--background-primary)",
  "tab-container-background": "var(--background-primary)",
  "tab-background-active": "var(--background-secondary)",
  "status-bar-background": "var(--background-primary)",
  "caret-color": "var(--text-accent)",
  "header-height": "38px",
  "status-bar-border-color": "transparent",
  "status-bar-border-width": "0px",
  "tab-divider-color": "transparent",
  "status-bar-position": "relative",
  "status-bar-radius": "0",
  "nav-item-padding": "4px 0px 4px 24px",
  "nav-item-color": "var(--text-normal)",
  "nav-item-color-active": "var(--text-accent)",
  "nav-item-weight-hover": "bold",
  "nav-collapse-icon-color": "var(--text-accent)",
  "h1-weight": "500",
  "h2-weight": "700",
  "h3-weight": "550",
  "h4-weight": "500",
  "h5-weight": "500",
  "h6-weight": "500",
  "checkbox-radius": "var(--radius-xl)",
  "ribbon-padding": "10px 2px 10px 2px",
  "ribbon-width": "42px",
  "nav-item-margin-bottom": "1px",
  "nav-item-weight-active": "bold",
  "h1-color": { "light": "#D90000", "dark": "#D6821E" },
  "h2-color": { "dark": "#984806" },
  "h3-color": { "light": "#984806", "dark": "#629A53" },
  "h4-color": { "light": "#1971C2", "dark": "#4C8DAE" },
  "h5-color": { "dark": "#815476" },
  "h1-font": "得意黑, Segoe UI",
  "h2-font": "Segoe UI, Source Han Serif SC VF",
  "h3-font": "Segoe UI, Source Han Sans SC VF",
  "checkbox-size": "14px",
  "checkbox-margin-inline-start": "0.8em",
  "tab-outline-width": "-2px",
  "titlebar-background": "var(--background-primary)",
  "titlebar-background-focused": "var(--background-primary)",
  "indentation-guide-editing-indent": "0.6em",
  "list-indent-editing": "0.5em",
  "code-border-width": "1px",
  "code-radius": "6px"
}
